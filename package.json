{
  "name": "brewtui-bar",
  "version": "5.2.0",
  "description": "BrewTUI-Bar — Visual TUI and menu bar companion for Homebrew",
  "type": "module",
  "bin": {
    "brewtui-bar": "bin/brewtui-bar.js"
  },
  "main": "./build/index.js",
  "files": [
    "build/",
    "bin/",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoLinesDesigns/BrewTUI-Bar.git"
  },
  "bugs": {
    "url": "https://github.com/MoLinesDesigns/BrewTUI-Bar/issues"
  },
  "homepage": "https://github.com/MoLinesDesigns/BrewTUI-Bar#readme",
  "author": "MoLines Designs",
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --no-file-parallelism",
    "test:watch": "vitest",
    "test:serial": "vitest run --no-file-parallelism",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run test:coverage && npm run build && npm run lint",
    "check:brewtuibar-release": "node scripts/check-brewtuibar-release.mjs",
    "prepublishOnly": "npm run validate && npm run check:brewtuibar-release",
    "postinstall": "node build/postinstall.js",
    "prepare": "husky"
  },
  "keywords": [
    "homebrew",
    "brew",
    "tui",
    "terminal",
    "cli",
    "package-manager",
    "menubar"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@inkjs/ui": "2.0.0",
    "ink": "7.1.1",
    "react": "19.2.8",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rollup/rollup-darwin-arm64": "^4.60.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.0",
    "husky": "9.1.7",
    "ink-testing-library": "4.0.0",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "tsx": "4.23.5",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "ws": ">=8.21.0",
    "brace-expansion": ">=5.0.9",
    "esbuild": ">=0.28.1",
    "postcss": ">=8.5.18",
    "vite": ">=8.0.16"
  }
}
